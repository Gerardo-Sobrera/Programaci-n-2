public class ContadorVocales {

    public static void main(String[] args) {
        // 1. Almacenamiento del texto en una variable String
        String texto = "PROGRAMACION JAVA";
        
        int contadorVocales = 0;

        // 2. Recorrido del texto mediante un bucle for usando length() y charAt()
        for (int i = 0; i < texto.length(); i++) {
            char caracterActual = texto.charAt(i);

            // 3. Identificación de vocales (mayúsculas y minúsculas)
            if (esVocal(caracterActual)) {
                contadorVocales++;
            }
        }

        // 4. Despliegue de los resultados
        System.out.println("Texto analizado: " + texto);
        System.out.println("Cantidad de caracteres: " + texto.length());
        System.out.println("Cantidad de vocales: " + contadorVocales);
    }

    /**
     * Método auxiliar para verificar si un carácter es una vocal.
     * Evalúa tanto vocales mayúsculas como minúsculas.
     */
    private static boolean esVocal(char c) {
        char caracterMinuscula = Character.toLowerCase(c);
        return caracterMinuscula == 'a' || caracterMinuscula == 'e' || 
               caracterMinuscula == 'i' || caracterMinuscula == 'o' || 
               caracterMinuscula == 'u';
    }
}
